{
  "name": "underpressured-app",
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#styles/*": "./src/shared/styles/*"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "stylelint": "stylelint \"src/**/*.{css,astro}\"",
    "test": "vitest run --passWithNoTests",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "deploy": "bun run build && bun run deploy:upload",
    "deploy:upload": "wrangler deploy",
    "deploy:check": "bun run build && wrangler deploy --dry-run",
    "preview:cloudflare": "bun run build && wrangler dev",
    "check:built": "bun run build && node scripts/check-built-output.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "eslint": "^10.14.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-css-modules": "^1.16.1",
    "vitest": "^5.1.0",
    "wrangler": "4.160.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
