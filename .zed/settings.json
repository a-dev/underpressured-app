{
  "languages": {
    "Astro": {
      "formatter": [
        {
          "external": {
            "command": "bun",
            "arguments": ["x", "stylelint", "--stdin", "--stdin-filename", "{buffer_path}", "--fix"]
          }
        },
        {
          "external": {
            "command": "bun",
            "arguments": ["run", "oxfmt", "--stdin-filepath", "{buffer_path}"]
          }
        }
      ],
      "format_on_save": "on"
    },
    "CSS": {
      "formatter": [
        {
          "external": {
            "command": "bun",
            "arguments": ["x", "stylelint", "--stdin", "--stdin-filename", "{buffer_path}", "--fix"]
          }
        },
        {
          "external": {
            "command": "bun",
            "arguments": ["run", "oxfmt", "--stdin-filepath", "{buffer_path}"]
          }
        }
      ],
      "format_on_save": "on"
    },
    "TypeScript": {
      "language_servers": ["tsgo", "!vtsls", "!typescript-language-server"],
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["run", "oxfmt", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    },
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["run", "oxfmt", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    },
    "JSON": {
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["run", "oxfmt", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    },
    "JSONC": {
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["run", "oxfmt", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    },
    "Markdown": {
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["run", "oxfmt", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    },
    "YAML": {
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["run", "oxfmt", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    }
  },
  "lsp": {
    "css-variables": {
      "settings": {
        "cssVariables": {
          "lookupFiles": ["src/shared/styles/**/*.css"],
          "undefinedVarFallback": "info"
        }
      }
    },
    "vscode-css-language-server": {
      "settings": {
        "css": {
          "customData": ["./.vscode/css-custom-data.json"]
        }
      }
    }
  }
}
