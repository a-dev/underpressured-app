{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "underpressured-app",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "underpressured.app", "custom_domain": true }],
}
